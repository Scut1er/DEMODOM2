  id: event_hell_call
  title: "\u0417\u0412\u041E\u041D\u041E\u041A \u0418\u0417 \u0410\u0414\u0410"
  subtitle: "\u0441\u043E\u0432\u0435\u0442 \u0434\u0438\u0440\u0435\u043A\u0442\u043E\u0440\u043E\u0432 \u043D\u0430 \u043B\u0438\u043D\u0438\u0438"
  description: "\u041D\u0430\u0447\u0430\u043B\u044C\u0441\u0442\u0432\u043E \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0440\u0435\u0439\u0442\u0438\u043D\u0433\u0430. \u041C\u043E\u0436\u043D\u043E \u0440\u0438\u0441\u043A\u043D\u0443\u0442\u044C."
  goal: 
  icon: 6
  color: {r: 0.78, g: 0.22, b: 0.2, a: 1}
  art: {fileID: 0}
  weight: 1
  conditions: []
  uniquePerEpisode: 1
  onEnter: []
  body: "\u0422\u0435\u043B\u0435\u0444\u043E\u043D \u0432 \u0430\u043F\u043F\u0430\u0440\u0430\u0442\u043D\u043E\u0439 \u0440\u0430\u0441\u043A\u0430\u043B\u0451\u043D \u0434\u043E\u043A\u0440\u0430\u0441\u043D\u0430. \u0413\u043E\u043B\u043E\u0441 \u0432 \u0442\u0440\u0443\u0431\u043A\u0435 \u043D\u0435 \u043C\u043E\u0440\u0433\u0430\u0435\u0442: \xAB\u041D\u0430\u043C \u043D\u0443\u0436\u0435\u043D \u0441\u043A\u0430\u043D\u0434\u0430\u043B. \u0421\u0435\u0433\u043E\u0434\u043D\u044F. \u0418\u043D\u0430\u0447\u0435 \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442 \u0441\u0433\u043E\u0440\u0438\u0442 \u2014 \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u0432\u0430\u043C\u0438\xBB."
  eventTags: []
  roles: []
  choices:
  - label: "\u041F\u043E\u043E\u0431\u0435\u0449\u0430\u0442\u044C \u0441\u043A\u0430\u043D\u0434\u0430\u043B"
    description: "\u0421\u043E\u0432\u0435\u0442 \u0449\u0435\u0434\u0440 \u043A \u043F\u043E\u0431\u0435\u0434\u0438\u0442\u0435\u043B\u044F\u043C \u0438 \u0436\u0435\u0441\u0442\u043E\u043A \u043A \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C."
    conditions: []
    hideIfUnavailable: 0
    costMoney: 0
    costCash: 0
    chance: 60
    effects:
    - type: 0
      key: 
      value: 80
      mood: 0
    - type: 1
      key: 
      value: 6
      mood: 1
    resultText: "\xAB\u0425\u043E\u0440\u043E\u0448\u0438\u0439 \u043C\u0430\u043B\u044C\u0447\u0438\u043A\xBB, \u2014 \u0448\u0438\u043F\u0438\u0442 \u0442\u0440\u0443\u0431\u043A\u0430. \u041D\u0430 \u0441\u0447\u0451\u0442 \u043F\u0430\u0434\u0430\u044E\u0442 \u043A\u0440\u0435\u0434\u0438\u0442\u044B."
    resultTags: []
    failEffects:
    - type: 0
      key: 
      value: -40
      mood: 0
    failText: "\xAB\u041C\u044B \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043C\xBB, \u2014 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0433\u043E\u043B\u043E\u0441, \u0438 \u0441\u043E \u0441\u0447\u0451\u0442\u0430 \u0438\u0441\u0447\u0435\u0437\u0430\u044E\u0442 \u043A\u0440\u0435\u0434\u0438\u0442\u044B. \u0410\u0432\u0430\u043D\u0441 \u0437\u0430 \u0434\u043E\u0432\u0435\u0440\u0438\u0435."
