      value: 8
      mood: 0
    resultText: "\u0427\u0435\u0440\u0435\u0437 \u043F\u044F\u0442\u044C \u043C\u0438\u043D\u0443\u0442 \u0441\u043B\u0443\u0445 \u0437\u043D\u0430\u0435\u0442 \u0432\u0435\u0441\u044C \u0434\u043E\u043C. {\u0432\u0442\u043E\u0440\u043E\u0439} \u0443\u0436\u0435 \u0441\u0442\u0443\u0447\u0438\u0442 \u0432 \u0434\u0432\u0435\u0440\u044C, \u0430 {\u0430\u043A\u0442\u0451\u0440} \u0434\u0435\u043B\u0430\u0435\u0442 \u0432\u0438\u0434, \u0447\u0442\u043E \u0441\u043F\u0438\u0442."
