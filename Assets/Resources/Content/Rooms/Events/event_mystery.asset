  id: event_mystery
  title: "\u0421\u041B\u0423\u0425 \u0418\u0417 \u0413\u0420\u0418\u041C\u0401\u0420\u041A\u0418"
  subtitle: "\u043A\u0442\u043E-\u0442\u043E \u0447\u0442\u043E-\u0442\u043E \u0441\u043B\u044B\u0448\u0430\u043B"
  description: "\u0412 \u0433\u0440\u0438\u043C\u0451\u0440\u043A\u0435 \u0448\u0435\u043F\u0447\u0443\u0442\u0441\u044F. \u0421\u043B\u0443\u0445 \u043C\u043E\u0436\u043D\u043E \u043F\u0443\u0441\u0442\u0438\u0442\u044C \u0432 \u0434\u0435\u043B\u043E \u2014 \u0438\u043B\u0438 \u043F\u0440\u0438\u0434\u0435\u0440\u0436\u0430\u0442\u044C."
