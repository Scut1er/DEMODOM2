  choices:
  - label: "\u0421\u043B\u0438\u0442\u044C \u0432 \u043E\u0431\u0449\u0438\u0439 \u0447\u0430\u0442"
    description: "\u0414\u0440\u0430\u043C\u0430 \u043F\u0440\u044F\u043C\u043E \u0441\u0435\u0439\u0447\u0430\u0441 \u2014 \u043D\u043E \u0434\u043E\u0432\u0435\u0440\u0438\u044F \u043A \u043F\u0440\u043E\u0434\u044E\u0441\u0435\u0440\u0443 \u043C\u0435\u043D\u044C\u0448\u0435."
