  icon: 13
  color: {r: 0.45, g: 0.3, b: 0.6, a: 1}
  art: {fileID: 0}
  weight: 1
  conditions: []
  uniquePerEpisode: 1
  onEnter: []
  body: "\u0413\u0440\u0438\u043C\u0451\u0440\u0448\u0430 \u043F\u043E \u0441\u0435\u043A\u0440\u0435\u0442\u0443 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442: {\u0430\u043A\u0442\u0451\u0440} \u043D\u043E\u0447\u044C\u044E \u0437\u0432\u043E\u043D\u0438\u043B(\u0430) \u043A\u043E\u043C\u0443-\u0442\u043E \u0438 \u043F\u043B\u0430\u043A\u0430\u043B(\u0430) \u0432 \u0442\u0440\u0443\u0431\u043A\u0443. \u0415\u0441\u043B\u0438 \u044D\u0442\u043E \u0432\u0441\u043F\u043B\u044B\u0432\u0451\u0442, {\u0432\u0442\u043E\u0440\u043E\u0439} \u0442\u043E\u0447\u043D\u043E \u043D\u0435 \u043F\u0440\u043E\u043C\u043E\u043B\u0447\u0438\u0442.\n\n\u0421\u043B\u0443\u0445 \u0433\u043E\u0440\u044F\u0447\u0438\u0439. \u0427\u0442\u043E \u0441 \u043D\u0438\u043C \u0434\u0435\u043B\u0430\u0442\u044C?"
  eventTags: []
  roles:
  - key: "\u0430\u043A\u0442\u0451\u0440"
