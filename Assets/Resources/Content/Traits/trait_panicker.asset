  shortDescription: "\u0427\u0443\u0442\u044C \u0447\u0442\u043E \u2014 \u043F\u0430\u043D\u0438\u043A\u0430: \u0431\u0435\u0433\u0430\u0435\u0442, \u043A\u0440\u0438\u0447\u0438\u0442, \u043C\u0435\u0448\u0430\u0435\u0442 \u0432\u0441\u0435\u043C."
  gameplayHints:
  - "\u0441\u0442\u0440\u0435\u0441\u0441 \u0440\u0430\u0441\u0442\u0451\u0442 \u0431\u044B\u0441\u0442\u0440\u0435\u0435"
  - "\u043E\u0433\u043E\u043D\u044C \u0438 \u0442\u0440\u0435\u0432\u043E\u0433\u0430 \u2192 \u043F\u0430\u043D\u0438\u043A\u0430"
  - "\u0432 \u043F\u0430\u043D\u0438\u043A\u0435 \u0441\u0431\u0438\u0432\u0430\u0435\u0442 \u0434\u0440\u0443\u0433\u0438\u0445 \u0441 \u0442\u043E\u043B\u043A\u0443"
